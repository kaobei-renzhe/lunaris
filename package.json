{
  "name": "lunaris",
  "version": "0.2.1",
  "description": "本地优先的图片素材库：照片、相机与文字都归在这里",
  "main": "./out/main/index.js",
  "author": "silvermoon",
  "license": "MIT",
  "build": {
    "appId": "com.silvermoon.lunaris",
    "productName": "月相",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json",
      "build/icon.png",
      "!**/node_modules/onnxruntime-node/bin/napi-*/darwin/**",
      "!**/node_modules/onnxruntime-node/bin/napi-*/linux/**",
      "!**/node_modules/onnxruntime-node/bin/napi-*/win32/arm64/**"
    ],
    "npmRebuild": false,
    "asarUnpack": [
      "**/*.node",
      "**/node_modules/onnxruntime-node/**",
      "**/node_modules/@img/**"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "月相"
    }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bench": "node scripts/bench.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never && node scripts/clean-release.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "exifr": "^7.1.3",
    "lucide-react": "^1.61.0",
    "onnxruntime-node": "^1.30.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
